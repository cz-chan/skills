---
import CopyButton from "@presentation/components/ui/CopyButton/CopyButton.astro";
import styles from "./InstallCommand.module.css";

interface Props {
	/** Ruta de la skill en el repo: "skills/code-mentor". */
	path: string;
}

const { path } = Astro.props;

/**
 * Carpeta de skills del proyecto que lee cada agente, según su documentación oficial (2026-10-13).
 * Claude Code no lee .agents/skills; Codex, Copilot, Cursor, Gemini CLI y OpenCode sí.
 * Codex y Gemini CLI no leen .claude/skills.
 */
const targets = [
	{
		id: "agents",
		label: "All (.agents)",
		dir: ".agents/skills",
		warning: "Claude doesn't read .agents yet, only .claude.",
	},
	{
		id: "claude",
		label: "Claude (.claude)",
		dir: ".claude/skills",
		warning: "Some agents only read .agents.",
	},
];

/** Scripts de public/: descargan la skill de GitHub en el proyecto del usuario. */
const systems = [
	{
		id: "unix",
		label: "macOS / Linux",
		command: (skill: string, dir: string) =>
			`curl -fsSL ${new URL("/install.sh", Astro.site)} | sh -s ${skill} ${dir}`,
	},
	{
		id: "windows",
		label: "Windows",
		// irm | iex no admite argumentos; el scriptblock sí.
		command: (skill: string, dir: string) =>
			`& ([scriptblock]::Create((irm ${new URL("/install.ps1", Astro.site)}))) ${skill} ${dir}`,
	},
];

const skill = path.replace(/^skills\//, "");
// Un comando por combinación "<sistema>:<carpeta>"; el script del cliente elige.
const commands = Object.fromEntries(
	systems.flatMap((s) =>
		targets.map((t) => [`${s.id}:${t.id}`, s.command(skill, t.dir)]),
	),
);
---

<div
	class={styles.install}
	data-install
	data-commands={JSON.stringify(commands)}
>
	<div class={styles.selects}>
		<label class={styles.label}>
			install for
			<select
				class={styles.select}
				data-install-target
			>
				{
					targets.map((t) => (
						<option
							value={t.id}
							data-warning={t.warning}
						>
							{t.label}
						</option>
					))
				}
			</select>
		</label>
		<label class={styles.label}>
			on
			<select
				class={styles.select}
				data-install-os
			>
				{systems.map((s) => <option value={s.id}>{s.label}</option>)}
			</select>
		</label>
	</div>
	<CopyButton text={commands[`${systems[0].id}:${targets[0].id}`]} />
	<p
		class={styles.warning}
		data-install-warning
	>
		⚠ {targets[0].warning}
	</p>
</div>

<script>
	const KEYS = { target: "install-target", os: "install-os" } as const;

	const load = (key: string) => {
		try {
			return localStorage.getItem(key);
		} catch {
			return null;
		}
	};
	const save = (key: string, value: string) => {
		try {
			localStorage.setItem(key, value);
		} catch {}
	};

	// astro:page-load: también tras navegar con el ClientRouter, no solo en la primera carga.
	document.addEventListener("astro:page-load", () => {
		const savedTarget = load(KEYS.target);
		// Sin preferencia guardada, se adivina por el navegador.
		const savedOs =
			load(KEYS.os) ??
			(/Win/i.test(navigator.userAgent) ? "windows" : null);

		document
			.querySelectorAll<HTMLElement>("[data-install]")
			.forEach((install) => {
				const target = install.querySelector<HTMLSelectElement>(
					"[data-install-target]",
				);
				const os = install.querySelector<HTMLSelectElement>(
					"[data-install-os]",
				);
				const code = install.querySelector("code");
				const button = install.querySelector<HTMLButtonElement>("[data-copy]");
				const warning = install.querySelector<HTMLElement>(
					"[data-install-warning]",
				);
				if (!target || !os || !code || !button) return;

				const commands: Record<string, string> = JSON.parse(
					install.dataset.commands ?? "{}",
				);
				const restore = (select: HTMLSelectElement, value: string | null) => {
					if (value && [...select.options].some((o) => o.value === value))
						select.value = value;
				};
				const apply = () => {
					const command = commands[`${os.value}:${target.value}`] ?? "";
					code.textContent = command;
					button.dataset.copy = command;
					if (warning)
						warning.textContent = `⚠ ${target.selectedOptions[0]?.dataset.warning ?? ""}`;
				};

				restore(target, savedTarget);
				restore(os, savedOs);
				apply();
				target.addEventListener("change", () => {
					apply();
					save(KEYS.target, target.value);
				});
				os.addEventListener("change", () => {
					apply();
					save(KEYS.os, os.value);
				});
			});
	});
</script>
