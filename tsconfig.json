{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist", "evals"],
	"compilerOptions": {
		"paths": {
			"@domain/*": ["./src/domain/*"],
			"@application/*": ["./src/application/*"],
			"@infrastructure/*": ["./src/infrastructure/*"],
			"@presentation/*": ["./src/presentation/*"],
			"@container": ["./src/container.ts"]
		}
	}
}
